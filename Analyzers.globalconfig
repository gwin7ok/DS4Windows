# 追加のアナライザー（Sonar・Threading・AsyncFixer）の規則の設定（PhaseRV1-2。経緯と件数は docs-forDIMG/MadeByAgent/PhaseRV1-Analyzer-Survey.md）。
# DS4Windows/DS4WinWPF.csproj の GlobalAnalyzerConfigFiles から読み込む。.editorconfig の設定は、この設定より優先される。
#
# 運用の規則:
# - 件数が 0 の規則は、既定の重大度（警告）のまま使う。新しい違反は、ビルドの警告になる（是正すること。ここへ none を足さない）。
# - 今ある違反がある規則は、段階導入の対象なら suggestion、そうでなければ none にして、凍結する。
# - 段階導入の規則は、違反が 0 になった Phase で warning へ上げ、PhaseRV1-Analyzer-Survey.md の表に記録する。
# - 上の none の規則は、使うと決めたときに、違反を 0 にしてから、この行を消す（消すと既定の重大度＝警告になる）。
# - パッケージを上げたときに新しい警告が出たら、同じ手順で扱う。

is_global = true

# ---- 段階導入の対象（suggestion） ----
# AsyncFixer03: ハンドラー以外の async void（導入時 9 件）
dotnet_diagnostic.AsyncFixer03.severity = suggestion
# VSTHRD002: Task の同期的な待ち（デッドロックの危険）（導入時 11 件）
dotnet_diagnostic.VSTHRD002.severity = suggestion
# VSTHRD110: 待たれない（観測されない）Task（導入時 40 件）
dotnet_diagnostic.VSTHRD110.severity = suggestion
# S2486: 握りつぶした例外（理由のコメントがない catch）（導入時 359 件）
dotnet_diagnostic.S2486.severity = suggestion
# S1481: 未使用のローカル変数（導入時 36 件）
dotnet_diagnostic.S1481.severity = suggestion

# ---- Sonar（SonarAnalyzer.CSharp）: 今は使わない規則（none。導入時の件数は PhaseRV1-Analyzer-Survey.md） ----
