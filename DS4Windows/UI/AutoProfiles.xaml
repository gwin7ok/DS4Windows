<UserControl x:Class="DS4Windows.UI.AutoProfiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:localConverters="clr-namespace:DS4Windows.UI.Converters"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4Windows.UI"
             xmlns:entity="clr-namespace:DS4Windows.Core.Profiles"
             mc:Ignorable="d" 
             IsEnabled="{Binding IsIdle}"
             d:DesignHeight="380" d:DesignWidth="800">
    <DockPanel>
            <ScrollViewer x:Name="sidebarScrollViewer" DockPanel.Dock="Right" Width="Auto" Margin="8" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Thickness x:Key="spaceMargin" Bottom="8" />
                </ScrollViewer.Resources>
                <StackPanel x:Name="outerEditControlsPanel">
                    <StackPanel.Resources>
                        <CollectionViewSource x:Key="profileCollection" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                    </StackPanel.Resources>

                    <StackPanel x:Name="editControlsPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <!-- 選択中の項目（ProgramItem）がない間は操作できない。項目でない DataContext でも、Filename が引けず null になる -->
                                    <DataTrigger Binding="{Binding Filename, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="30">
                            <Button x:Name="removeAutoBtn" Content="{lex:Loc Remove}" Height="20" Padding="1" Width="80"
                        IsEnabled="{Binding Exists}" Command="{Binding DataContext.RemoveAutoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button x:Name="saveAutoBtn" Content="{lex:Loc Save}" Margin="20,0,0,0" Height="20" Width="80" Command="{Binding DataContext.SaveAutoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                        <Grid x:Name="autoProfilesGrid" Margin="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{lex:Loc Controller1Text}" Margin="{StaticResource spaceMargin}" />
                            <ComboBox x:Name="cont1AutoProf" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon1}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer x:Name="cont1AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller2Text}" Grid.Row="1" Margin="{StaticResource spaceMargin}" />
                            <ComboBox x:Name="cont2AutoProf" Grid.Row="1" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon2}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer x:Name="cont2AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller3Text}" Grid.Row="2" Margin="{StaticResource spaceMargin}" />
                            <ComboBox x:Name="cont3AutoProf" Grid.Row="2" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon3}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer x:Name="cont3AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller4Text}" Grid.Row="3" Margin="{StaticResource spaceMargin}" />
                            <ComboBox x:Name="cont4AutoProf" Grid.Row="3" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon4}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer x:Name="cont4AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller5Text}" Grid.Row="4" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont5AutoProf" Grid.Row="4" Grid.Column="1" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon5}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller6Text}" Grid.Row="5" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont6AutoProf" Grid.Row="5" Grid.Column="1" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon6}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>


                        <Label Content="{lex:Loc Controller7Text}" Grid.Row="6" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont7AutoProf" Grid.Row="6" Grid.Column="1" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon7}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller8Text}" Grid.Row="7" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont8AutoProf" Grid.Row="7" Grid.Column="1" Visibility="{Binding ExpandedControllersShown, Mode=OneWay, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon8}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Ui_None}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>

                    <CheckBox Content="{lex:Loc TurnOffDS4WindowsTemporarily}" Margin="{StaticResource spaceMargin}"
                          IsChecked="{Binding Turnoff}" />
                        <TextBox Text="{Binding Path}" Margin="{StaticResource spaceMargin}" ToolTip="{lex:Loc AutoProfPathTip}"/>

                        <Grid>
                            <TextBox x:Name="mainTxtBox" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource spaceMargin}" ToolTip="{lex:Loc AutoProfTitleTip}" />

                            <TextBlock Margin="5,2" MinWidth="50" Text="{lex:Loc AutoProfiles_WindowTitle}" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.7" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>

                        <Border Height="4" Background="{DynamicResource BorderBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                <CheckBox x:Name="revertDefaultProfileOnUnknownCk" Content="{lex:Loc RevertToDefaultProfileOnUnknown}" Margin="0,10,0,0" IsChecked="{Binding RevertDefaultProfileOnUnknown}" />
                <CheckBox x:Name="showAutoDebugCk" Content="{lex:Loc ShowAutoProfileDebugMessages}" Margin="0,10,0,0" IsChecked="{Binding AutoDebug}" />
                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                    <Label Content="{lex:Loc AutoProfiles.DisplaySwitchVia}" />
                    <ComboBox ItemsSource="{Binding DisplayProfileSwitchList}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding ProfileSwitchChoice}" />
                </StackPanel>

            </StackPanel>
            </ScrollViewer>

        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
                <Button x:Name="addProgramsBtn" Content="{lex:Loc AddPrograms}" Click="AddProgramsBtn_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="steamMenuItem" Header="{lex:Loc AddSteamGames}" Command="{Binding AddFromSteamCommand}" Visibility="{Binding ShowSteamMenu, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" />
                            <MenuItem x:Name="startMenuItem" Header="{lex:Loc AddStartMenuPrograms}" Command="{Binding AddFromStartMenuCommand}" Visibility="{Binding ShowStartMenu, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}" />
                            <MenuItem x:Name="browseProgsMenuItem" Header="{lex:Loc AddDirectory}" Command="{Binding AddFromFolderCommand}" />
                            <MenuItem x:Name="browseAddProgMenuItem" Header="{lex:Loc BrowseOtherPrograms}" Command="{Binding AddProgramFileCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="hideUncheckedBtn" Content="{lex:Loc HideUnchecked}" Margin="20,0,0,0" Command="{Binding HideUncheckedCommand}" />
            </StackPanel>
            <ListView x:Name="programListLV" PreviewMouseUp="ProgramListLV_PreviewMouseUp" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True" SelectedIndex="{Binding SelectedIndex}" SelectedItem="{Binding SelectedItem}" Margin="8,0,0,8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{lex:Loc MainWindow_ColName}" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Exists,Mode=OneWay}" IsEnabled="False" Margin="0,10,0,0" />
                                        <Image Source="{Binding Path, Converter={x:Static localConverters:FileIconConverter.Instance}}" Width="30" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Filename}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{lex:Loc Path}" Width="600" DisplayMemberBinding="{Binding Path}"/>
                        <GridViewColumn Header="{lex:Loc MainWindow_ColWindowTitle}" Width="Auto" DisplayMemberBinding="{Binding Title}"/>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{lex:Loc MoveUp}" Name="MoveUp" Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="{lex:Loc MoveDown}" Name="MoveDown" Command="{Binding MoveDownCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </DockPanel>
    </DockPanel>
</UserControl>
