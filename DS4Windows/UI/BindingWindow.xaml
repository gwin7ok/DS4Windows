<Window x:Class="DS4Windows.UI.BindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4Windows.UI"
        xmlns:controls="clr-namespace:DS4Windows.UI.Controls"
        xmlns:localConverters="clr-namespace:DS4Windows.UI.Converters"
        mc:Ignorable="d"
        Title="{lex:Loc BindingWindow_SelectAction}"
        Height="540"
        Width="1020"
        Closing="Window_Closing"
        Style="{DynamicResource WindowStyle}"
        FontSize="10">
    <Window.Resources>
        <local:BindingWinResourcePaths x:Key="resourcePaths"/>
        <localConverters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <!-- Exceptions: input controls should remain at readable size -->
        <Style TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
        <Style TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
        <Style TargetType="PasswordBox"
               BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
        <Style TargetType="xctk:IntegerUpDown"
               BasedOn="{StaticResource {x:Type xctk:IntegerUpDown}}">
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
    </Window.Resources>
    <!-- Reduce overall font size for this window's content (except inputs)
            Inputs are restored to readable size by styles above. -->
    <DockPanel x:Name="fullPanel"
               Margin="4">
        <StackPanel x:Name="extrasSidePanel"
                    Visibility="{Binding DataContext.ShowMainPanels, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"
                    Width="160"
                    Orientation="Vertical"
                    DockPanel.Dock="Right">
            <StackPanel.Resources>
                <Thickness x:Key="spaceMargin"
                           Bottom="8"/>
            </StackPanel.Resources>

            <GroupBox Header="{lex:Loc Extra}"
                      x:Name="extrasGB"
                      Margin="0,16,0,0">
                <StackPanel Orientation="Vertical"
                            Margin="2,0">
                    <StackPanel Orientation="Horizontal"
                                Margin="{StaticResource spaceMargin}">
                        <Label Content="{lex:Loc Rumble}"/>
                        <Button x:Name="testRumbleBtn"
                                Width="60"
                                Content="{lex:Loc Test}"
                                Command="{Binding TestRumbleBtnCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="{StaticResource spaceMargin}">
                        <Label Content="{lex:Loc Heavy}"
                               Width="50"/>
                        <xctk:IntegerUpDown Value="{Binding HeavyRumble}"
                                            MinWidth="60"
                                            Margin="20,0,0,0"
                                            Minimum="0"
                                            Maximum="255"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="{StaticResource spaceMargin}">
                        <Label Content="{lex:Loc Light}"
                               Width="50"/>
                        <xctk:IntegerUpDown Value="{Binding LightRumble}"
                                            MinWidth="60"
                                            Margin="20,0,0,0"
                                            Minimum="0"
                                            Maximum="255"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="{StaticResource spaceMargin}">
                            <CheckBox Content="{lex:Loc BindingWin.ChangeLight}"
                                      IsChecked="{Binding UseExtrasColor}"
                                      Margin="{StaticResource spaceMargin}"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="R"/>
                                <Slider Value="{Binding ExtrasColorR}"
                                        Minimum="0"
                                        Maximum="255"
                                        ToolTip="{Binding ExtrasColorR}"
                                        MinWidth="100"
                                        Background="{Binding ExtrasColorRString, FallbackValue=Red}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="G"/>
                                <Slider Value="{Binding ExtrasColorG}"
                                        MinWidth="100"
                                        Minimum="0"
                                        Maximum="255"
                                        ToolTip="{Binding ExtrasColorG}"
                                        Background="{Binding ExtrasColorGString, FallbackValue=Lime}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="B"/>
                                <Slider Value="{Binding ExtrasColorB}"
                                        MinWidth="100"
                                        Minimum="0"
                                        Maximum="255"
                                        ToolTip="{Binding ExtrasColorB}"
                                        Background="{Binding ExtrasColorBString, FallbackValue=Blue}"/>
                            </StackPanel>
                            <Button x:Name="extrasColorChoosebtn"
                                    Width="20"
                                    Height="20"
                                    Background="{Binding ExtrasColorString}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,10,0"
                                    Click="ExtrasColorChoosebtn_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="{StaticResource spaceMargin}">
                            <Label Content="{lex:Loc FlashRate}"/>
                            <xctk:IntegerUpDown MinWidth="50"
                                                Value="{Binding FlashRate}"
                                                Minimum="0"
                                                Maximum="20"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="{lex:Loc BindingWin.ChangeMouseSensitivity}"
                                      IsChecked="{Binding UseMouseSens}"
                                      Margin="{StaticResource spaceMargin}"/>
                            <xctk:IntegerUpDown Value="{Binding MouseSens}"
                                                MinWidth="50"
                                                Height="20"
                                                Minimum="0"
                                                Maximum="255"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <DockPanel x:Name="mapBindingPanel"
                   Visibility="{Binding DataContext.ShowMainPanels, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"
                   DockPanel.Dock="Top">
            <!-- ホバーの名前の表示が上の端のボタン（L2・R2）で図の外へはみ出すため、あとから描かれる下のタブより前に置く -->
            <DockPanel x:Name="bottomPanel"
                       Panel.ZIndex="1"
                       DockPanel.Dock="Bottom"
                       Margin="0,4,0,0">
                <StackPanel x:Name="modePanel"
                            Visibility="{Binding DataContext.Layout.ShowModePanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"
                            Width="160"
                            DockPanel.Dock="Left"
                            Margin="8,0,0,0">

                    <Button x:Name="defaultBtn"
                            Content="{Binding DefaultBtnString,FallbackValue={lex:Loc Default}}"
                            Background="{Binding IsDefaultSelected, Converter={x:Static localConverters:OutputSelectionBrushConverter.Instance}, FallbackValue={StaticResource SecondaryBrush}}"
                            Margin="0,50,0,0"
                            Command="{Binding DataContext.PickDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button x:Name="unboundBtn"
                            Content="{lex:Loc Unbound}"
                            Background="{Binding IsUnboundSelected, Converter={x:Static localConverters:OutputSelectionBrushConverter.Instance}, FallbackValue={StaticResource SecondaryBrush}}"
                            Margin="0,10,0,0"
                            Command="{Binding DataContext.PickUnboundCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <StackPanel x:Name="outConPanel"
                            Width="630"
                            Orientation="Vertical"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Center"
                            Margin="0">
                    <!-- Controlsタブと同じ背景色を適用し、角を少し丸めると綺麗になります -->
                    <Border Background="{DynamicResource BindingCanvasBackground}"
                            CornerRadius="4">
                        <controls:ControllerVisualizerControl x:Name="conVisualizer"
                                                  Height="247"
                                                  Layout="{x:Static controls:ControllerLayouts.Xbox360}">
                            <controls:ControllerVisualizerControl.Background>
                                <ImageBrush x:Name="conImageBrush"
                                            ImageSource="{Binding Source={StaticResource resourcePaths}, Path=Xbox360MapPNG}"
                                            Stretch="Uniform"/>
                            </controls:ControllerVisualizerControl.Background>
                            <controls:ControllerVisualizerControl.Resources>
                                <Style TargetType="{x:Type Button}"
                                       x:Key="NoBGHoverBtn">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Name="border"
                                                        BorderThickness="0"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </controls:ControllerVisualizerControl.Resources>
                            <controls:ControllerVisualizerControl.ButtonStyle>
                                <StaticResource ResourceKey="NoBGHoverBtn"/>
                            </controls:ControllerVisualizerControl.ButtonStyle>
                            <Image x:Name="highlightImg"
                                   Width="20"
                                   Height="20"
                                   Source="{Binding Source={StaticResource resourcePaths}, Path=Xbox360HighlightPNG}"
                                   Canvas.Left="622"
                                   Canvas.Top="11"
                                   Panel.ZIndex="2"
                                   IsHitTestVisible="False"
                                   IsEnabled="False"/>
                            <Label x:Name="highlightLb"
                                   Content="A"
                                   Panel.ZIndex="2"
                                   IsHitTestVisible="False"
                                   Background="{DynamicResource KeyHighlight.Background}"
                                   Foreground="{DynamicResource KeyHighlight.Foreground}"
                                   IsEnabled="False"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"/>
                        </controls:ControllerVisualizerControl>
                    </Border>
                </StackPanel>

            </DockPanel>

            <TabControl x:Name="mapOptionsPanel"
                        DockPanel.Dock="Top"
                        Foreground="{x:Null}"
                        BorderBrush="{x:Null}"
                        Margin="0">
                <TabItem Header="{lex:Loc BindingWin.KeyAndRelMouse}">
                    <DockPanel>
                        <Grid x:Name="topGrid"
                              DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.9*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left">
                                <Label x:Name="macroOnLb"
                                       Content="{lex:Loc BindingWin.MacroOn}"
                                       Visibility="{Binding DataContext.Layout.ShowMacroOnLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="keyMouseTopTxt"
                                           Text="{lex:Loc BindingWin.KeyboardAndMouse}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="topOptsPanel"
                                        Visibility="{Binding DataContext.Layout.ShowTopOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"
                                        Orientation="Horizontal"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <CheckBox Content="{lex:Loc Toggle}"
                                          IsChecked="{Binding Toggle}"/>
                                <CheckBox Content="{lex:Loc ScanCode}"
                                          IsChecked="{Binding HasScanCode}"
                                          Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="recordMacroBtn"
                                        Visibility="{Binding DataContext.Layout.ShowRecordMacro, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static localConverters:BoolToVisibleCollapsedConverter.Instance}}"
                                        Content="{lex:Loc BindingWin.RecordAMacro}"
                                        Command="{Binding RecordMacroBtnCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="mainBindGrid"
                              DockPanel.Dock="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <!-- Left: 文字キー、Middle: カーソル/Home/テンキー、Right: マウス -->
                                <ColumnDefinition Width="0.99*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="0.3*"
                                                  MinWidth="140"/>
                            </Grid.ColumnDefinitions>
                            <UniformGrid Columns="1"
                                         Grid.Column="0">
                                <UniformGrid.Resources>
                                    <!-- Reduce keyboard button font size to ~0.8x for better fit -->
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="FontSize"
                                                Value="10"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.Resources>
                                        <Style x:Key="midMar"
                                               TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin"
                                                    Value="6,0,0,0"/>
                                        </Style>
                                    </Grid.Resources>

                                    <Button x:Name="escBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x1B"
                                            Content="{lex:Loc BindingWindow_Esc}"
                                            Grid.Column="0"/>
                                    <Button x:Name="f1Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x70"
                                            Content="F1"
                                            Grid.Column="1"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f2Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x71"
                                            Content="F2"
                                            Grid.Column="2"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f3Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x72"
                                            Content="F3"
                                            Grid.Column="3"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f4Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x73"
                                            Content="F4"
                                            Grid.Column="4"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f5Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x74"
                                            Content="F5"
                                            Grid.Column="5"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f6Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x75"
                                            Content="F6"
                                            Grid.Column="6"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f7Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x76"
                                            Content="F7"
                                            Grid.Column="7"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f8Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x77"
                                            Content="F8"
                                            Grid.Column="8"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f9Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x78"
                                            Content="F9"
                                            Grid.Column="9"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f10Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x79"
                                            Content="F10"
                                            Grid.Column="10"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f11Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x7A"
                                            Content="F11"
                                            Grid.Column="11"
                                            Style="{StaticResource midMar}"/>
                                    <Button x:Name="f12Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x7B"
                                            Content="F12"
                                            Grid.Column="12"
                                            Style="{StaticResource midMar}"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="1.75*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.Resources>
                                        <Style x:Key="midMargin"
                                               TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin"
                                                    Value="6,0,0,0"/>
                                        </Style>
                                    </Grid.Resources>

                                    <Button x:Name="oem3Btn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xC0"
                                            Content="`"
                                            Grid.Column="0"/>
                                    <Button x:Name="oneBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x31"
                                            Content="1"
                                            Grid.Column="1"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="twoBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x32"
                                            Content="2"
                                            Grid.Column="2"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="threeBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x33"
                                            Content="3"
                                            Grid.Column="3"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="fourBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x34"
                                            Content="4"
                                            Grid.Column="4"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="fiveBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x35"
                                            Content="5"
                                            Grid.Column="5"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="sixBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x36"
                                            Content="6"
                                            Grid.Column="6"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="sevenBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x37"
                                            Content="7"
                                            Grid.Column="7"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="eightBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x38"
                                            Content="8"
                                            Grid.Column="8"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="nineBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x39"
                                            Content="9"
                                            Grid.Column="9"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="zeroBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x30"
                                            Content="0"
                                            Grid.Column="10"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="minusBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xBD"
                                            Content="-"
                                            Grid.Column="11"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="equalBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xBB"
                                            Content="="
                                            Grid.Column="12"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="bsBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x08"
                                            Content="{lex:Loc BindingWindow_BkSpace}"
                                            Grid.Column="13"
                                            Style="{StaticResource midMargin}"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style x:Key="midMargin"
                                               TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin"
                                                    Value="6,0,0,0"/>
                                        </Style>
                                    </Grid.Resources>

                                    <Button x:Name="tabBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x09"
                                            Content="{lex:Loc BindingWindow_Tab}"
                                            Grid.Column="0"/>
                                    <Button x:Name="qKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x51"
                                            Content="Q"
                                            Grid.Column="1"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="wKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x57"
                                            Content="W"
                                            Grid.Column="2"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="eKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x45"
                                            Content="E"
                                            Grid.Column="3"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="rKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x52"
                                            Content="R"
                                            Grid.Column="4"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="tKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x54"
                                            Content="T"
                                            Grid.Column="5"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="yKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x59"
                                            Content="Y"
                                            Grid.Column="6"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="uKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x55"
                                            Content="U"
                                            Grid.Column="7"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="iKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x49"
                                            Content="I"
                                            Grid.Column="8"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="oKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x4F"
                                            Content="O"
                                            Grid.Column="9"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="pKey"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0x50"
                                            Content="P"
                                            Grid.Column="10"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="lbracketBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xDB"
                                            Content="["
                                            Grid.Column="11"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="rbracketBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xDD"
                                            Content="]"
                                            Grid.Column="12"
                                            Style="{StaticResource midMargin}"/>
                                    <Button x:Name="bSlashBtn"
                                            Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0xDC"
                                            Content="\"
                                            Grid.Column="13"
                                            Style="{StaticResource midMargin}"/>
                                </Grid>

