<UserControl x:Class="DS4Windows.UI.ControllerReadingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:props="clr-namespace:DS4Windows.Properties"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4Windows.UI"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="480">
    <DockPanel LastChildFill="False">
        <DockPanel DockPanel.Dock="Top"
                   LastChildFill="False"
                   Margin="4,0,4,0">
            <!-- 左側: コントローラー番号 / 入力遅延 / バッテリー -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <Label x:Name="inputContNum"
                           Content="#"
                           FontWeight="Bold"/>
                    <Label x:Name="inputDelayLb"
                           Content="{lex:Loc ReadingsControl.InputDelayNA}"
                           Margin="8,0,0,0">
                        <Label.Background>
                            <SolidColorBrush x:Name="inpuDelayBackBrush"
                                             Color="Transparent"/>
                        </Label.Background>
                        <Label.Foreground>
                            <SolidColorBrush x:Name="inpuDelayForeBrush"
                                             Color="Black"/>
                        </Label.Foreground>
                    </Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="20,0,0,0">
                    <Label x:Name="batteryLvlLb"
                           Content="{lex:Loc ReadingsControl.BatteryZero}"
                           Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- 右側: 仮想コントローラー出力遅延 (内部変換時間) -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        Margin="0,0,6,0">
                <Label x:Name="outputDelayLb"
                       Content="{x:Static props:Resources.OutputDelayNA}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- 3スティック表示エリア: 固定幅を外し利用可能な幅全体にゆったり拡張 -->
        <Grid DockPanel.Dock="Top"
              Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左スティック -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">
                <Label Content="{lex:Loc LeftStick}"
                       HorizontalAlignment="Center"
                       Padding="0"/>
                <Label Content=""
                       HorizontalAlignment="Center"
                       Padding="0"/>
                <Canvas x:Name="lsCanvas"
                        Width="130"
                        Height="130"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Rectangle Width="130"
                               Height="130"
                               Stroke="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                    <Ellipse x:Name="lsDeadEllipse"
                             Width="{Binding Path=Width, ElementName=lsCanvas}"
                             Height="{Binding Path=Height, ElementName=lsCanvas}"
                             Fill="{DynamicResource Readings.DeadZoneFill}">
                    </Ellipse>
                    <Ellipse x:Name="lsDriftEllipse"
                             Width="{Binding Path=Width, ElementName=lsCanvas}"
                             Height="{Binding Path=Height, ElementName=lsCanvas}"
                             Fill="{DynamicResource Readings.AlertFill}">
                    </Ellipse>
                    <Rectangle x:Name="lsMapValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource Readings.MapValue}">
                    </Rectangle>
                    <Rectangle x:Name="lsValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                </Canvas>
                <!-- Phase11 W2: 数値の見切れ防止。(I)/(O) の組を WrapPanel に入れ、列の幅に収まらない大きなフォントでは 2 行に折り返す（右スティック・SixAxis も同じ） -->
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="LX (I):"
                               Padding="2,2"/>
                        <Label x:Name="lxInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="LX (O):"
                               Padding="2,2"/>
                        <Label x:Name="lxOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="LY (I):"
                               Padding="2,2"/>
                        <Label x:Name="lyInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="LY (O):"
                               Padding="2,2"/>
                        <Label x:Name="lyOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <!-- 右スティック -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center">
                <Label Content="{lex:Loc RightStick}"
                       HorizontalAlignment="Center"
                       Padding="0"/>
                <Label Content=""
                       HorizontalAlignment="Center"
                       Padding="0"/>
                <Canvas x:Name="rsCanvas"
                        Width="130"
                        Height="130"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Rectangle Width="{Binding Path=Width, ElementName=rsCanvas}"
                               Height="{Binding Path=Height, ElementName=rsCanvas}"
                               Stroke="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                    <Ellipse x:Name="rsDeadEllipse"
                             Width="{Binding Path=Width, ElementName=rsCanvas}"
                             Height="{Binding Path=Height, ElementName=rsCanvas}"
                             Fill="{DynamicResource Readings.DeadZoneFill}">
                    </Ellipse>
                    <Ellipse x:Name="rsDriftEllipse"
                             Width="{Binding Path=Width, ElementName=rsCanvas}"
                             Height="{Binding Path=Height, ElementName=rsCanvas}"
                             Fill="{DynamicResource Readings.AlertFill}">
                    </Ellipse>
                    <Rectangle x:Name="rsMapValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource Readings.MapValue}">
                    </Rectangle>
                    <Rectangle x:Name="rsValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                </Canvas>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="RX (I):"
                               Padding="2,2"/>
                        <Label x:Name="rxInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="RX (O):"
                               Padding="2,2"/>
                        <Label x:Name="rxOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="RY (I):"
                               Padding="2,2"/>
                        <Label x:Name="ryInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="RY (O):"
                               Padding="2,2"/>
                        <Label x:Name="ryOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabel}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <!-- SixAxis -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center">
                <TextBlock Text="{lex:Loc ReadingsControl.SixAxisXText}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <Canvas x:Name="sixaxisCanvas"
                        Width="130"
                        Height="130"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Rectangle Width="{Binding Path=Width, ElementName=sixaxisCanvas}"
                               Height="{Binding Path=Height, ElementName=sixaxisCanvas}"
                               Stroke="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                    <Ellipse x:Name="sixAxisDeadEllipse"
                             Width="{Binding Path=Width, ElementName=sixaxisCanvas}"
                             Height="{Binding Path=Height, ElementName=sixaxisCanvas}"
                             Fill="{DynamicResource Readings.AlertFill}">
                    </Ellipse>
                    <Rectangle x:Name="sixAxisMapValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource Readings.MapValue}">
                    </Rectangle>
                    <Rectangle x:Name="sixAxisValRec"
                               Width="6"
                               Height="6"
                               Canvas.Left="62"
                               Canvas.Top="62"
                               Fill="{DynamicResource ForegroundBrush}">
                    </Rectangle>
                    <Ellipse x:Name="gyroCalEllipse"
                             Fill="{DynamicResource Readings.Calibration}"
                             Height="32"
                             Canvas.Left="90"
                             Canvas.Top="10"
                             Width="32"/>
                </Canvas>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="X (I):"
                               Padding="2,2"/>
                        <Label x:Name="sixAxisXInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabelWide}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="X (O):"
                               Padding="2,2"/>
                        <Label x:Name="sixAxisXOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabelWide}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal"
             Margin="0,0,4,0">
                        <Label Content="Z (I):"
                               Padding="2,2"/>
                        <Label x:Name="sixAxisZInValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabelWide}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Z (O):"
                               Padding="2,2"/>
                        <Label x:Name="sixAxisZOutValLb"
                               Content=""
                               Style="{DynamicResource ReadingValueLabelWide}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- トリガーおよびジャイロ/加速度エリア -->
        <Grid DockPanel.Dock="Top"
              Margin="8,30,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            <!-- トリガー (L2 / R2) および タッチパッド (TX / TY) 表示エリア -->
            <StackPanel Orientation="Horizontal"
                        MinHeight="100"
                        Grid.Column="0"
                        HorizontalAlignment="Center">

                <!-- Phase11 W2: 幅 470 のとき、この列は約 205。グループの固定幅を詰め（L2/R2: 58＋右余白 4、TX/TY: 70。合計 194）、右端の TX/TY が欠けないようにした -->
                <!-- === L2 グループ === -->
                <StackPanel Width="58"
                            Margin="0,0,4,0">
                    <!-- 上段: スライダーとL2インジケーター (中央揃え) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Height="80">
                        <Label x:Name="l2ValLb"
                               Content="L2"
                               Height="16"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               RenderTransformOrigin="0.5,1"
                               Padding="0"
                               Margin="0,0,4,0">
                            <Label.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="l2ValLbTrans"
                                                        Y="66"/>
                                </TransformGroup>
                            </Label.RenderTransform>
                            <Label.Foreground>
                                <SolidColorBrush x:Name="l2ValLbBrush"
                                                 Color="Black"/>
                            </Label.Foreground>
                        </Label>
                        <Slider x:Name="l2Slider"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="255"
                                Value="0"
                                Height="80"
                                Focusable="False"/>
                    </StackPanel>

                    <!-- 下段: I / O 数値 (中央揃え & 3桁が余裕で収まる幅に調整) -->
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="I:"
                                   Width="18"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="l2InValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="O:"
                                   Width="18"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="l2OutValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- === R2 グループ === -->
                <StackPanel Width="58"
                            Margin="0,0,4,0">
                    <!-- 上段: スライダーとR2インジケーター (中央揃え) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Height="80">
                        <Slider x:Name="r2Slider"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="255"
                                Value="0"
                                Height="80"
                                Focusable="False"/>
                        <Label x:Name="r2ValLb"
                               Content="R2"
                               Height="16"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               RenderTransformOrigin="0.5,1"
                               Padding="0"
                               Margin="4,0,0,0">
                            <Label.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="r2ValLbTrans"
                                                        Y="66"/>
                                </TransformGroup>
                            </Label.RenderTransform>
                            <Label.Foreground>
                                <SolidColorBrush x:Name="r2ValLbBrush"
                                                 Color="Black"/>
                            </Label.Foreground>
                        </Label>
                    </StackPanel>

                    <!-- 下段: I / O 数値 (中央揃え & 3桁が余裕で収まる幅に調整) -->
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="I:"
                                   Width="18"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="r2InValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="O:"
                                   Width="18"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="r2OutValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- === TX / TY グループ (タッチパッド) === -->
                <StackPanel Width="70">
                    <StackPanel Height="80"/>
                    <!-- 下段: TX / TY 数値 -->
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="TX:"
                                   Width="28"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="touchXValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="TY:"
                                   Width="28"
                                   Padding="1,1"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="touchYValLb"
                                   Content=""
                                   Style="{DynamicResource ReadingValueLabelCentered}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ForegroundBrush}">
                <StackPanel Orientation="Horizontal"
                            Margin="6"
                            HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,6,0">
                        <Label Content="{lex:Loc Gyro}"
                               HorizontalAlignment="Center"
                               Padding="0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{lex:Loc Yaw}"
                                   Width="46"/>
                            <Slider x:Name="gyroYawSlider"
                                    Width="80"
                                    Minimum="-9000"
                                    Maximum="9000"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{lex:Loc Pitch}"
                                   Width="46"/>
                            <Slider x:Name="gyroPitchSlider"
                                    Width="80"
                                    Minimum="-9000"
                                    Maximum="9000"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{lex:Loc Roll}"
                                   Width="46"/>
                            <Slider x:Name="gyroRollSlider"
                                    Width="80"
                                    Minimum="-9000"
                                    Maximum="9000"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="{lex:Loc Accel}"
                               HorizontalAlignment="Center"
                               Padding="0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="X"
                                   Width="20"/>
                            <Slider x:Name="accelXSlider"
                                    Width="80"
                                    Minimum="-128"
                                    Maximum="128"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Y"
                                   Width="20"/>
                            <Slider x:Name="accelYSlider"
                                    Width="80"
                                    Minimum="-128"
                                    Maximum="128"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Z"
                                   Width="20"/>
                            <Slider x:Name="accelZSlider"
                                    Width="80"
                                    Minimum="-128"
                                    Maximum="128"
                                    Value="0"
                                    Focusable="False"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>