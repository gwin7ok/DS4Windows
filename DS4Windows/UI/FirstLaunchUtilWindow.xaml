<Window x:Class="DS4Windows.UI.FirstLaunchUtilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4Windows.UI"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="{lex:Loc FirstLaunch.WinTitle}" Width="800" SizeToContent="Height" MaxHeight="600"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <!-- Window will likely be used for other first launch configuration in the future.
         For now, only deal with device mapper support -->
    <DockPanel>
        <Button Content="{lex:Loc Close}" Click="Button_Click" DockPanel.Dock="Bottom" Margin="16,16,16,16" />

        <TabControl Name="pagesTabControl" TabStripPlacement="Left">
            <TabItem Header="{lex:Loc FirstLaunch.DeviceSupport}" Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{lex:Loc FirstLaunch.Header}" FontWeight="UltraBold" FontSize="16" HorizontalAlignment="Center"
                               Margin="0,8,0,0" DockPanel.Dock="Top" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Orientation="Vertical" Margin="4">
                            <TextBlock TextWrapping="Wrap"
                                       DockPanel.Dock="Top">
                                <TextBlock.Text>
                                    <lex:Loc Key="FirstLaunch.DeviceIntroText"></lex:Loc>
                                </TextBlock.Text>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding FamilyToggles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding FirstLaunchLabel}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding FirstLaunchText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                <TextBlock Visibility="{Binding HasHelpUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Hyperlink Click="HelpLink_Click" Foreground="{DynamicResource LinkAccentBrush}"><Run Text="{Binding HelpUrl, Mode=OneWay}" /></Hyperlink>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
