<UserControl x:Class="DS4Windows.UI.RecordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4Windows.UI"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800" KeyDown="UserControl_KeyDown" KeyUp="UserControl_KeyUp" MouseDown="UserControl_MouseDown" MouseUp="UserControl_MouseUp" Focusable="True" >
    <UserControl.Resources>
        <DataTemplate x:Key="DisplayTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Image}" Height="16" Width="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Step.Name}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="EditTemplate">
            <xctk:IntegerUpDown x:Name="waitIUD" Value="{Binding DisplayValue,UpdateSourceTrigger=Explicit}"
                                KeyDown="WaitIUD_KeyDown" />
        </DataTemplate>
        <DataTemplate x:Key="EditRumbleTemplate">
            <StackPanel x:Name="rumbleEditPabel" Orientation="Horizontal">
                <xctk:IntegerUpDown x:Name="heavyRumbleUD" Value="{Binding RumbleHeavy,UpdateSourceTrigger=Explicit}" Minimum="0" Maximum="255" />
                <xctk:IntegerUpDown x:Name="lightRumbleUD" Value="{Binding RumbleLight,UpdateSourceTrigger=Explicit}" Minimum="0" Maximum="255" />
            </StackPanel>
        </DataTemplate>

        <!-- マウス移動ステップの編集（モード、X、Y）。Enter か、選択の変更・保存で確定する -->
        <DataTemplate x:Key="EditPointerMoveTemplate">
            <StackPanel x:Name="pointerMoveEditPanel" Orientation="Horizontal">
                <ComboBox x:Name="pointerModeCb" SelectedIndex="{Binding PointerModeIndex,UpdateSourceTrigger=Explicit}" Margin="0,0,6,0" KeyDown="PointerMoveEdit_KeyDown" SelectionChanged="PointerModeCb_SelectionChanged">
                    <ComboBoxItem Content="{lex:Loc RecordBox.MoveModeAbsolute}" />
                    <ComboBoxItem Content="{lex:Loc RecordBox.MoveModeWindow}" />
                </ComboBox>
                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0" />
                <xctk:IntegerUpDown x:Name="pointerXUD" Value="{Binding PointerX,UpdateSourceTrigger=Explicit}" Minimum="-8192" Maximum="12287" Margin="0,0,6,0" KeyDown="PointerMoveEdit_KeyDown" />
                <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,0" />
                <xctk:IntegerUpDown x:Name="pointerYUD" Value="{Binding PointerY,UpdateSourceTrigger=Explicit}" Minimum="-8192" Maximum="12287" KeyDown="PointerMoveEdit_KeyDown" />
            </StackPanel>
        </DataTemplate>

        <local:RecordBoxResourcePaths x:Key="resourcePaths" />
    </UserControl.Resources>
    <DockPanel Margin="4">
        <DockPanel DockPanel.Dock="Right" Width="200" LastChildFill="False" Margin="4,0">
            <StackPanel DockPanel.Dock="Top">
                <UniformGrid Rows="1">
                    <Button x:Name="saveBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc Save}" Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,5,0" />
                    <Button x:Name="cancelBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc Cancel}" Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0" />
                </UniformGrid>

                <Button x:Name="recordBtn" Content="{lex:Loc RecordText}" Margin="0,10,0,0" Command="{Binding RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <CheckBox x:Name="recordDelaysCk" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.RecordDelays}" HorizontalAlignment="Left" IsChecked="{Binding RecordDelays}" Margin="0,10,0,0" />

                <!-- マウスの移動の記録（既定はオフ。オフのときは、従来どおり、このボックスの上のボタンだけを記録する）。
                     下の一覧は、記録する座標の基準であり、Add Mouse Move で追加するステップの基準でもある -->
                <CheckBox x:Name="recordMouseMoveCk" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.RecordMouseMovement}" IsChecked="{Binding RecordMouseMovement}" Margin="0,10,0,0" />
                <ComboBox x:Name="pointerRecordModeCb" IsEnabled="{Binding ControlsEnabled}" SelectedIndex="{Binding PointerRecordModeIndex}" Margin="0,4,0,0">
                    <ComboBoxItem Content="{lex:Loc RecordBox.MoveModeAbsolute}" />
                    <ComboBoxItem Content="{lex:Loc RecordBox.MoveModeWindow}" />
                </ComboBox>

                <Button x:Name="addMouseMoveBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.AddMouseMove}" Margin="0,10,5,0" Command="{Binding AddMouseMoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{lex:Loc RecordBox.DoubleClickMoveEdit}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <Button x:Name="addWaitTimeBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.InsertWait}" Margin="0,10,5,0" Command="{Binding AddWaitTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{lex:Loc RecordBox.DoubleClickWaitEdit}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <UniformGrid Rows="1" Columns="2" FirstColumn="1" Margin="0,10,0,0">
                    <Button x:Name="clearStepsBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc Clear}" Margin="5,00,0,0" Command="{Binding ClearStepsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </UniformGrid>

                <UniformGrid Rows="1" Margin="0,10,0,0">
                    <Button x:Name="loadPresetBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.LoadPreset}" Margin="0,0,5,0" Command="{Binding LoadPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button x:Name="savePresetBtn" IsEnabled="{Binding ControlsEnabled}" Content="{lex:Loc RecordBox.SavePreset}" Margin="5,0,0,0" Command="{Binding SavePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </UniformGrid>

                <local:MacroPlaybackOptionsPanel x:Name="playbackPanel" AllowModeEdit="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" DataContext="{Binding PlaybackOptions}" Margin="0,10,0,0" />
            </StackPanel>
        </DockPanel>
        <DockPanel x:Name="leftSideDockPanel" DockPanel.Dock="Left">
            <DockPanel DockPanel.Dock="Top">
                <Label Content="{lex:Loc RecordBox.MacroOrder}" />
                <Label Content="{lex:Loc RecordBox.UseActionToRecord}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
            <!-- Ctrl+クリックで複数選択、Shift+クリックで範囲選択（Extended）。空白のクリックで選択解除、Delete で選択行を削除、ドラッグ＆ドロップで並べ替え -->
            <ListBox x:Name="macroListBox" IsEnabled="{Binding ControlsEnabled}" ItemsSource="{Binding MacroSteps}" SelectionMode="Extended" AllowDrop="True"
                     ItemTemplate="{StaticResource DisplayTemplate}" MouseDoubleClick="MacroListBox_MouseDoubleClick"
                     LostFocus="MacroListBox_LostFocus"
                     PreviewMouseLeftButtonDown="MacroListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="MacroListBox_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="MacroListBox_PreviewMouseLeftButtonUp"
                     DragOver="MacroListBox_DragOver" Drop="MacroListBox_Drop">
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
