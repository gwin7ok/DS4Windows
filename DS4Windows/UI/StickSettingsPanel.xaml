                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding RSDeadZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc MaxZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="1"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding RSMaxZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc AntiDeadZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="2"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding RSAntiDeadZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="2"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}">
                                        <xctk:DoubleUpDown.ToolTip>
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="{lex:Loc AntiDeadzoneTooltip}">
                                            </TextBlock>
                                        </xctk:DoubleUpDown.ToolTip>
                                    </xctk:DoubleUpDown>

                                    <Label Content="{lex:Loc MaxOutput}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="3"
                                           Grid.Column="0"/>
                                    <DockPanel Grid.Row="3"
                                               Grid.Column="1">
                                        <CheckBox Content="Force"
                                                  IsChecked="{Binding RSMaxOutputForce}"
                                                  VerticalAlignment="Center"
                                                  DockPanel.Dock="Right"
                                                  ToolTip="{lex:Loc StickMaxOutputForceTooltip}"
                                                  Margin="8,0,0,0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           Value="{Binding RSMaxOutput}"
                                                           FormatString="F2"
                                                           Style="{StaticResource NumberInputSmall}"
                                                           Maximum="1.0"
                                                           Minimum="0.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           DockPanel.Dock="Left">
                                            <xctk:DoubleUpDown.ToolTip>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="{lex:Loc StickMaxOutputTooltip}">
                                                </TextBlock>
                                            </xctk:DoubleUpDown.ToolTip>
                                        </xctk:DoubleUpDown>
                                    </DockPanel>

                                    <Label Content="{lex:Loc VerticalScale}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="4"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding RSVerticalScale}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="4"
                                                       Grid.Column="1"
                                                       Maximum="4.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc Sensitivity}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="5"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding RSSens}"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="5"
                                                       Grid.Column="1"
                                                       Maximum="5.0"
                                                       Minimum="0.1"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{lex:Loc Axial}"
                                     Visibility="Collapsed">
                                <local:AxialStickUserControl x:Name="axialRSStickControl"/>
                            </TabItem>
                        </TabControl>

                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Content="{lex:Loc OutputCurve}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="0"
                                   Grid.Column="0"/>
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      SelectedIndex="{Binding RSOutputCurveIndex}"
                                      Margin="{StaticResource spaceMargin}">
                                <ComboBoxItem Content="{lex:Loc Linear}"/>
                                <ComboBoxItem Content="{lex:Loc EnhancedPrecision}"/>
                                <ComboBoxItem Content="{lex:Loc Quadratic}"/>
                                <ComboBoxItem Content="{lex:Loc Cubic}"/>
                                <ComboBoxItem Content="{lex:Loc EaseoutQuad}"/>
                                <ComboBoxItem Content="{lex:Loc EaseoutCubic}"/>
                                <ComboBoxItem Content="{lex:Loc Custom}"/>
                            </ComboBox>

                            <DockPanel Grid.Row="1"
                                       Grid.Column="1"
                                       IsEnabled="{Binding RSCustomCurveSelected}">
                                <Button x:Name="rsCustomEditorBtn"
                                        Content="..."
                                        Tag="RS"
                                        Width="20"
                                        DockPanel.Dock="Right"
                                        Click="CustomEditorBtn_Click"
                                        Margin="{StaticResource spaceMargin}"/>
                                <TextBox Text="{Binding RSCustomCurve,UpdateSourceTrigger=LostFocus,FallbackValue='0.00, 0.00, 1.00, 1.00'}"
                                         DockPanel.Dock="Left"
                                         Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>

                            <Label Content="{lex:Loc SquareStick}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="2"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <CheckBox IsChecked="{Binding RSSquareStick}"
                                          Margin="{StaticResource spaceMargin}"
                                          VerticalAlignment="Center"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F1"
                                                   Value="{Binding RSSquareRoundness,FallbackValue=5}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="1000.0"
                                                   Increment="1.0"
                                                   IsEnabled="{Binding RSSquareStick}"
                                                   Margin="{StaticResource spaceMargin}"/>
                            </StackPanel>

                            <Label Content="Rotation:"
                                   Grid.Row="3"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="3"
                                       Grid.Column="1">
                                <TextBlock Text="&#xb0;"
                                           DockPanel.Dock="Right"
                                           FontSize="18"
                                           Margin="{StaticResource spaceMargin}"/>
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    Value="{Binding RSRotation}"
                                                    Minimum="-180"
                                                    Maximum="180"
                                                    Margin="{StaticResource spaceMargin}">
                                    <xctk:IntegerUpDown.ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{lex:Loc StickRotationTooltip}">
                                        </TextBlock>
                                    </xctk:IntegerUpDown.ToolTip>
                                </xctk:IntegerUpDown>
                            </DockPanel>

                            <Label Content="{lex:Loc Fuzz}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="4"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="4"
                                       Grid.Column="1">
                                <TextBlock Text="units"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    Value="{Binding RSFuzz}"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Margin="{StaticResource spaceMargin}">
                                    <xctk:IntegerUpDown.ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{lex:Loc StickFuzzTooltip}">
                                        </TextBlock>
                                    </xctk:IntegerUpDown.ToolTip>
                                </xctk:IntegerUpDown>
                            </DockPanel>

                            <Label Content="{lex:Loc AntiSnapback}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="5"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <CheckBox IsChecked="{Binding RSAntiSnapback}"
                                          Margin="{StaticResource spaceMargin}"
                                          VerticalAlignment="Center"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F1"
                                                   Value="{Binding RSAntiSnapbackDelta, FallbackValue=135}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="256.0"
                                                   Increment="1.0"
                                                   IsEnabled="{Binding RSAntiSnapback}"
                                                   Margin="{StaticResource spaceMargin}"/>
                                <TextBlock Text="units"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Label Content="{lex:Loc AntiSnapbackTiming}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="6"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    FormatString="F1"
                                                    Value="{Binding RSAntiSnapbackTimeout}"
                                                    Style="{StaticResource NumberInputWide}"
                                                    Minimum="0"
                                                    Maximum="1000"
                                                    Increment="1"
                                                    IsEnabled="{Binding RSAntiSnapback}"
                                                    Margin="{StaticResource spaceMargin}"/>
                                <TextBlock Text="ms"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Label Content="{lex:Loc OuterBtn}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="7"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="7"
                                       Grid.Column="1">
                                <Label x:Name="rsOuterBindLb"
                                       Content="{Binding MappingName,FallbackValue=Unassigned}"
                                       Margin="{StaticResource spaceMargin}"
                                       HorizontalAlignment="Center"
                                       DockPanel.Dock="Top"/>
                            </DockPanel>

                            <Label Content="{lex:Loc OuterBtnDead}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="8"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="8"
                                       Grid.Column="1">
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F2"
                                                   Value="{Binding RSOuterBindDead}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="1.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"
                                                   ToolTip="{lex:Loc StickOuterBindDeadTooltip}"
                                                   DockPanel.Dock="Top"/>
                                <CheckBox Content="Invert"
                                          IsChecked="{Binding RSOuterBindInvert}"
                                          ToolTip="{lex:Loc StickOuterBindInvertTooltip}"
                                          DockPanel.Dock="Top"
                                          HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Label Grid.Row="9"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Content="{lex:Loc StickCalibration}"
                                   HorizontalContentAlignment="Center"
                                   Margin="0 4 0 4"/>

                            <Label Content="{lex:Loc XAxisOffset}"
                                   Grid.Row="10"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="10"
                                       Grid.Column="1">
                                <xctk:SByteUpDown d:IsHidden="True"
                                                  Value="{Binding RightStickDriftXAxis,UpdateSourceTrigger=LostFocus}"
                                                  Style="{StaticResource NumberInputSmall}"
                                                  Maximum="127"
                                                  Minimum="-127"
                                                  Increment="1"
                                                  Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>

                            <Label Content="{lex:Loc YAxisOffset}"
                                   Grid.Row="11"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="11"
                                       Grid.Column="1">
                                <xctk:SByteUpDown d:IsHidden="True"
                                                  Value="{Binding RightStickDriftYAxis,UpdateSourceTrigger=LostFocus}"
                                                  Style="{StaticResource NumberInputSmall}"
                                                  Maximum="127"
                                                  Minimum="-127"
                                                  Increment="1"
                                                  Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>
                            <Button Grid.Row="12"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Content="{lex:Loc AutomaticallyRecalibrateStick}"
                                    Click="CalibrateStick_OnClick"
                                    Tag="1"/>
                        </Grid>

                        <GroupBox Header="{lex:Loc DeltaAcceleration}"
                                  DockPanel.Dock="Top">
                            <StackPanel Orientation="Vertical">
                                <DockPanel LastChildFill="False">
                                    <Label Content="{lex:Loc Enabled}"
                                           ContentStringFormat="{}{0}:"
                                           DockPanel.Dock="Left"/>
                                    <CheckBox IsChecked="{Binding RSDeltaAccelEnabled}"
                                              Margin="{StaticResource spaceMargin}"
                                              DockPanel.Dock="Right"/>
                                </DockPanel>

                                <Expander IsExpanded="{Binding RSDeltaAccelEnabled,Mode=OneTime}"
                                          Header="Settings">
                                    <Grid IsEnabled="{Binding RSDeltaAccelEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label Content="{lex:Loc Multiplier}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="0"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding RSDeltaMultiplier}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="10.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="0"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc MaxTravel}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="1"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding RSDeltaMaxTravel}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="1.0"
                                                           Increment="0.05"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="1"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc MinTravel}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="2"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding RSDeltaMinTravel}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="1.0"
                                                           Increment="0.05"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="2"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc EasingDuration}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="3"
                                               Grid.Column="0"/>
                                        <DockPanel Grid.Row="3"
                                                   Grid.Column="1">
                                            <TextBlock Text="sec"
                                                       DockPanel.Dock="Right"
                                                       FontSize="10"
                                                       Margin="{StaticResource spaceMargin}"
                                                       VerticalAlignment="Center"/>
                                            <xctk:DoubleUpDown d:IsHidden="True"
                                                               FormatString="F2"
                                                               Value="{Binding RSDeltaEasingDuration}"
                                                               Style="{StaticResource NumberInputWide}"
                                                               Minimum="0.0"
                                                               Maximum="600.0"
                                                               Increment="0.1"
                                                               Margin="{StaticResource spaceMargin}"/>
                                        </DockPanel>

                                        <Label Content="{lex:Loc MinFactor}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="4"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding RSDeltaMinFactor}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="1.0"
                                                           Maximum="10.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="4"
                                                           Grid.Column="1"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>

                </TabItem>
                <TabItem Header="{lex:Loc FlickStick}"
                         Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                        </Grid.RowDefinitions>

                        <Label Content="{lex:Loc RealWorldCalibration}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="0"
                               Grid.Column="0"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding RSFlickRWC,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Maximum="200.0"
                                           Minimum="1.0"
                                           Increment="1.0"
                                           Margin="{StaticResource spaceMargin}"/>

                        <Label Content="{lex:Loc FlickThreshold}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="1"
                               Grid.Column="0"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding RSFlickThreshold,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Maximum="1.0"
                                           Minimum="0.0"
                                           Increment="0.1"
                                           Margin="{StaticResource spaceMargin}"/>

                        <Label Content="{lex:Loc FlickTime}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="2"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="2"
                                   Grid.Column="1">
                            <TextBlock Text="sec."
                                       DockPanel.Dock="Right"
                                       Margin="{StaticResource spaceMargin}"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               Value="{Binding RSFlickTime,UpdateSourceTrigger=LostFocus}"
                                               FormatString="F2"
                                               Style="{StaticResource NumberInputSmall}"
                                               Maximum="10.0"
                                               Minimum="0.01"
                                               Increment="0.1"
                                               Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>

                        <Label Content="{lex:Loc MinAngleThreshold}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="3"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="3"
                                   Grid.Column="1">
                            <TextBlock Text="&#xb0;"
                                       DockPanel.Dock="Right"
                                       FontSize="18"
                                       Margin="{StaticResource spaceMargin}"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               Value="{Binding RSMinAngleThreshold,UpdateSourceTrigger=LostFocus}"
                                               FormatString="F2"
                                               Style="{StaticResource NumberInputSmall}"
                                               Maximum="180.0"
                                               Minimum="0.0"
                                               Increment="0.5"
                                               Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>


    </GroupBox>
    </StackPanel>
</UserControl>
