<UserControl x:Class="DS4Windows.UI.StickSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4Windows.UI"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Thickness x:Key="spaceMargin"
                   Left="10"
                   Bottom="6"/>
        <Style x:Key="gridRowHeight"
               TargetType="{x:Type RowDefinition}">
            <Setter Property="Height"
                    Value="30"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
    <GroupBox Header="LS">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="{lex:Loc OutputMode}"/>
                <ComboBox MinWidth="160"
                          SelectedIndex="{Binding LSOutputIndex,FallbackValue='0'}"
                          VerticalContentAlignment="Center"
                          Margin="10,0,0,0">
                    <ComboBoxItem Content="{lex:Loc None}"/>
                    <ComboBoxItem Content="{lex:Loc Controls}"/>
                    <ComboBoxItem Content="{lex:Loc FlickStick}"/>
                </ComboBox>
            </StackPanel>

            <TabControl SelectedIndex="{Binding LSOutputIndex,Mode=OneWay,FallbackValue='0'}"
                        BorderBrush="{x:Null}"
                        Padding="0"
                        Margin="0,10,0,0">
                <TabItem Header="{lex:Loc None}"
                         Visibility="Collapsed"/>
                <TabItem Header="{lex:Loc Controls}"
                         Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Top">
                            <Label Content="{lex:Loc DeadZoneType}"/>
                            <ComboBox MinWidth="160"
                                      SelectedIndex="{Binding LSDeadTypeIndex,FallbackValue='0'}"
                                      VerticalContentAlignment="Center"
                                      Margin="10,0,0,0">
                                <ComboBoxItem Content="{lex:Loc Radial}"/>
                                <ComboBoxItem Content="{lex:Loc Axial}"/>
                            </ComboBox>
                        </StackPanel>

                        <TabControl DockPanel.Dock="Top"
                                    SelectedIndex="{Binding LSDeadTypeIndex,Mode=OneWay,FallbackValue='0'}"
                                    BorderBrush="{x:Null}"
                                    Padding="0"
                                    Margin="0,8,0,8">
                            <TabItem Header="Radial"
                                     Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    </Grid.RowDefinitions>

                                    <Label Content="{lex:Loc DeadZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="0"
                                           Grid.Column="0"/>
                                    <!-- 2026-09-26: UpdateSourceTrigger=LostFocus を撤廃（Six Axis の Dead Zone と同じく即時に設定へ書き込み、Controller Readings の円を即時に更新する。Phase6-Step7b-Plan.md の範囲外の追加修正） -->
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding LSDeadZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc MaxZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="1"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding LSMaxZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc AntiDeadZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="2"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding LSAntiDeadZone}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="2"
                                                       Grid.Column="1"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}">
                                        <xctk:DoubleUpDown.ToolTip>
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="{lex:Loc AntiDeadzoneTooltip}">
                                            </TextBlock>
                                        </xctk:DoubleUpDown.ToolTip>
                                    </xctk:DoubleUpDown>

                                    <Label Content="{lex:Loc MaxOutput}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="3"
                                           Grid.Column="0"/>
                                    <DockPanel Grid.Row="3"
                                               Grid.Column="1">
                                        <CheckBox Content="Force"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding LSMaxOutputForce}"
                                                  ToolTip="{lex:Loc StickMaxOutputForceTooltip}"
                                                  DockPanel.Dock="Right"
                                                  Margin="8,0,0,0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           Value="{Binding LSMaxOutput}"
                                                           FormatString="F2"
                                                           Style="{StaticResource NumberInputSmall}"
                                                           Maximum="1.0"
                                                           Minimum="0.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           DockPanel.Dock="Left">
                                            <xctk:DoubleUpDown.ToolTip>
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="{lex:Loc StickMaxOutputTooltip}">
                                                </TextBlock>
                                            </xctk:DoubleUpDown.ToolTip>
                                        </xctk:DoubleUpDown>
                                    </DockPanel>

                                    <Label Content="{lex:Loc VerticalScale}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="4"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding LSVerticalScale}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="4"
                                                       Grid.Column="1"
                                                       Maximum="4.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                    <Label Content="{lex:Loc Sensitivity}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="5"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding LSSens}"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Grid.Row="5"
                                                       Grid.Column="1"
                                                       Maximum="5.0"
                                                       Minimum="0.1"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"/>

                                </Grid>
                            </TabItem>

                            <TabItem Header="{lex:Loc Axial}"
                                     Visibility="Collapsed">
                                <local:AxialStickUserControl x:Name="axialLSStickControl"/>
                            </TabItem>
                        </TabControl>

                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Content="{lex:Loc OutputCurve}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="0"
                                   Grid.Column="0"/>
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      SelectedIndex="{Binding LSOutputCurveIndex}"
                                      Margin="{StaticResource spaceMargin}">
                                <ComboBoxItem Content="{lex:Loc Linear}"/>
                                <ComboBoxItem Content="{lex:Loc EnhancedPrecision}"/>
                                <ComboBoxItem Content="{lex:Loc Quadratic}"/>
                                <ComboBoxItem Content="{lex:Loc Cubic}"/>
                                <ComboBoxItem Content="{lex:Loc EaseoutQuad}"/>
                                <ComboBoxItem Content="{lex:Loc EaseoutCubic}"/>
                                <ComboBoxItem Content="{lex:Loc Custom}"/>
                            </ComboBox>

                            <DockPanel Grid.Row="1"
                                       Grid.Column="1"
                                       IsEnabled="{Binding LSCustomCurveSelected}">
                                <Button x:Name="lsCustomEditorBtn"
                                        Content="..."
                                        Tag="LS"
                                        Width="20"
                                        DockPanel.Dock="Right"
                                        Click="CustomEditorBtn_Click"
                                        Margin="{StaticResource spaceMargin}"/>
                                <TextBox Text="{Binding LSCustomCurve,UpdateSourceTrigger=LostFocus,FallbackValue='0.00, 0.00, 1.00, 1.00'}"
                                         DockPanel.Dock="Left"
                                         Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>

                            <Label Content="{lex:Loc SquareStick}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="2"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <CheckBox IsChecked="{Binding LSSquareStick}"
                                          Margin="{StaticResource spaceMargin}"
                                          VerticalAlignment="Center"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F1"
                                                   Value="{Binding LSSquareRoundness,FallbackValue=5}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="1000.0"
                                                   Increment="1.0"
                                                   IsEnabled="{Binding LSSquareStick}"
                                                   Margin="{StaticResource spaceMargin}"/>
                            </StackPanel>

                            <Label Content="{lex:Loc Rotation}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="3"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="3"
                                       Grid.Column="1">
                                <TextBlock Text="&#xb0;"
                                           DockPanel.Dock="Right"
                                           FontSize="18"
                                           Margin="{StaticResource spaceMargin}"/>
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    Value="{Binding LSRotation}"
                                                    Minimum="-180"
                                                    Maximum="180"
                                                    Margin="{StaticResource spaceMargin}">
                                    <xctk:IntegerUpDown.ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{lex:Loc StickRotationTooltip}">
                                        </TextBlock>
                                    </xctk:IntegerUpDown.ToolTip>
                                </xctk:IntegerUpDown>
                            </DockPanel>

                            <Label Content="{lex:Loc Fuzz}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="4"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="4"
                                       Grid.Column="1">
                                <TextBlock Text="units"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    Value="{Binding LSFuzz}"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Margin="{StaticResource spaceMargin}">
                                    <xctk:IntegerUpDown.ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{lex:Loc StickFuzzTooltip}">
                                        </TextBlock>
                                    </xctk:IntegerUpDown.ToolTip>
                                </xctk:IntegerUpDown>
                            </DockPanel>

                            <Label Content="{lex:Loc AntiSnapback}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="5"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <CheckBox IsChecked="{Binding LSAntiSnapback}"
                                          Margin="{StaticResource spaceMargin}"
                                          VerticalAlignment="Center"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F1"
                                                   Value="{Binding LSAntiSnapbackDelta, FallbackValue=135}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="256.0"
                                                   Increment="1.0"
                                                   IsEnabled="{Binding LSAntiSnapback}"
                                                   Margin="{StaticResource spaceMargin}"/>
                                <TextBlock Text="units"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Label Content="{lex:Loc AntiSnapbackTiming}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="6"
                                   Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <xctk:IntegerUpDown d:IsHidden="True"
                                                    FormatString="F1"
                                                    Value="{Binding LSAntiSnapbackTimeout}"
                                                    Style="{StaticResource NumberInputWide}"
                                                    Minimum="0"
                                                    Maximum="1000"
                                                    Increment="1"
                                                    IsEnabled="{Binding LSAntiSnapback}"
                                                    Margin="{StaticResource spaceMargin}"/>
                                <TextBlock Text="ms"
                                           DockPanel.Dock="Right"
                                           FontSize="10"
                                           Margin="{StaticResource spaceMargin}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Label Content="{lex:Loc OuterBtn}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="7"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="7"
                                       Grid.Column="1">
                                <Label x:Name="lsOuterBindLb"
                                       Content="{Binding MappingName,FallbackValue=Unassigned}"
                                       Margin="{StaticResource spaceMargin}"
                                       HorizontalAlignment="Center"
                                       DockPanel.Dock="Top"/>
                            </DockPanel>

                            <Label Content="{lex:Loc OuterBtnDead}"
                                   ContentStringFormat="{}{0}:"
                                   Grid.Row="8"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="8"
                                       Grid.Column="1">
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F2"
                                                   Value="{Binding LSOuterBindDead}"
                                                   Style="{StaticResource NumberInputWide}"
                                                   Minimum="0.0"
                                                   Maximum="1.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"
                                                   ToolTip="{lex:Loc StickOuterBindDeadTooltip}"
                                                   DockPanel.Dock="Top"/>
                                <CheckBox Content="Invert"
                                          IsChecked="{Binding LSOuterBindInvert}"
                                          ToolTip="{lex:Loc StickOuterBindInvertTooltip}"
                                          DockPanel.Dock="Top"
                                          HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Label Grid.Row="9"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Content="{lex:Loc StickCalibration}"
                                   HorizontalContentAlignment="Center"
                                   Margin="0 4 0 4"/>

                            <Label Content="{lex:Loc XAxisOffset}"
                                   Grid.Row="10"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="10"
                                       Grid.Column="1">
                                <xctk:SByteUpDown d:IsHidden="True"
                                                  Value="{Binding LeftStickDriftXAxis,UpdateSourceTrigger=LostFocus}"
                                                  Style="{StaticResource NumberInputSmall}"
                                                  Maximum="127"
                                                  Minimum="-127"
                                                  Increment="1"
                                                  Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>

                            <Label Content="{lex:Loc YAxisOffset}"
                                   Grid.Row="11"
                                   Grid.Column="0"/>
                            <DockPanel Grid.Row="11"
                                       Grid.Column="1">
                                <xctk:SByteUpDown d:IsHidden="True"
                                                  Value="{Binding LeftStickDriftYAxis,UpdateSourceTrigger=LostFocus}"
                                                  Style="{StaticResource NumberInputSmall}"
                                                  Maximum="127"
                                                  Minimum="-127"
                                                  Increment="1"
                                                  Margin="{StaticResource spaceMargin}"/>
                            </DockPanel>
                            <Button Grid.Row="12"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Content="{lex:Loc AutomaticallyRecalibrateStick}"
                                    Click="CalibrateStick_OnClick"
                                    Tag="0"/>
                        </Grid>

                        <GroupBox Header="{lex:Loc DeltaAcceleration}"
                                  DockPanel.Dock="Top">
                            <StackPanel Orientation="Vertical">
                                <DockPanel LastChildFill="False">
                                    <Label Content="{lex:Loc Enabled}"
                                           ContentStringFormat="{}{0}:"
                                           DockPanel.Dock="Left"/>
                                    <CheckBox IsChecked="{Binding LSDeltaAccelEnabled}"
                                              Margin="{StaticResource spaceMargin}"
                                              DockPanel.Dock="Right"/>
                                </DockPanel>

                                <Expander IsExpanded="{Binding LSDeltaAccelEnabled,Mode=OneTime}"
                                          Header="Settings">
                                    <Grid IsEnabled="{Binding LSDeltaAccelEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label Content="{lex:Loc Multiplier}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="0"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding LSDeltaMultiplier}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="10.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="0"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc MaxTravel}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="1"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding LSDeltaMaxTravel}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="1.0"
                                                           Increment="0.05"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="1"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc MinTravel}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="2"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding LSDeltaMinTravel}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="1.0"
                                                           Increment="0.05"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="2"
                                                           Grid.Column="1"/>

                                        <Label Content="{lex:Loc EasingDuration}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="3"
                                               Grid.Column="0"/>
                                        <DockPanel Grid.Row="3"
                                                   Grid.Column="1">
                                            <TextBlock Text="sec"
                                                       DockPanel.Dock="Right"
                                                       FontSize="10"
                                                       Margin="{StaticResource spaceMargin}"
                                                       VerticalAlignment="Center"/>
                                            <xctk:DoubleUpDown d:IsHidden="True"
                                                               FormatString="F2"
                                                               Value="{Binding LSDeltaEasingDuration}"
                                                               Style="{StaticResource NumberInputWide}"
                                                               Minimum="0.0"
                                                               Maximum="600.0"
                                                               Increment="0.1"
                                                               Margin="{StaticResource spaceMargin}"/>
                                        </DockPanel>

                                        <Label Content="{lex:Loc MinFactor}"
                                               ContentStringFormat="{}{0}:"
                                               Grid.Row="4"
                                               Grid.Column="0"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding LSDeltaMinFactor}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="1.0"
                                                           Maximum="10.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"
                                                           Grid.Row="4"
                                                           Grid.Column="1"/>
                                    </Grid>
                                </Expander>

                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{lex:Loc FlickStick}"
                         Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                        </Grid.RowDefinitions>

                        <Label Content="{lex:Loc RealWorldCalibration}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="0"
                               Grid.Column="0"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding LSFlickRWC,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Maximum="200.0"
                                           Minimum="1.0"
                                           Increment="1.0"
                                           Margin="{StaticResource spaceMargin}"/>

                        <Label Content="{lex:Loc FlickThreshold}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="1"
                               Grid.Column="0"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding LSFlickThreshold,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Maximum="1.0"
                                           Minimum="0.0"
                                           Increment="0.1"
                                           Margin="{StaticResource spaceMargin}"/>

                        <Label Content="{lex:Loc FlickTime}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="2"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="2"
                                   Grid.Column="1">
                            <TextBlock Text="sec."
                                       DockPanel.Dock="Right"
                                       Margin="{StaticResource spaceMargin}"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               Value="{Binding LSFlickTime,UpdateSourceTrigger=LostFocus}"
                                               FormatString="F2"
                                               Style="{StaticResource NumberInputSmall}"
                                               Maximum="10.0"
                                               Minimum="0.01"
                                               Increment="0.1"
                                               Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>

                        <Label Content="{lex:Loc MinAngleThreshold}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="3"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="3"
                                   Grid.Column="1">
                            <TextBlock Text="&#xb0;"
                                       DockPanel.Dock="Right"
                                       FontSize="18"
                                       Margin="{StaticResource spaceMargin}"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               Value="{Binding LSMinAngleThreshold,UpdateSourceTrigger=LostFocus}"
                                               FormatString="F2"
                                               Style="{StaticResource NumberInputSmall}"
                                               Maximum="180.0"
                                               Minimum="0.0"
                                               Increment="0.5"
                                               Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>


    </GroupBox>

    <GroupBox Header="RS">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="{lex:Loc OutputMode}"/>
                <ComboBox MinWidth="160"
                          SelectedIndex="{Binding RSOutputIndex,FallbackValue='0'}"
                          VerticalContentAlignment="Center"
                          Margin="10,0,0,0">
                    <ComboBoxItem Content="{lex:Loc None}"/>
                    <ComboBoxItem Content="{lex:Loc Controls}"/>
                    <ComboBoxItem Content="{lex:Loc FlickStick}"/>
                </ComboBox>
            </StackPanel>


            <TabControl SelectedIndex="{Binding RSOutputIndex,Mode=OneWay,FallbackValue='0'}"
                        BorderBrush="{x:Null}">
                <TabItem Header="{lex:Loc None}"
                         Visibility="Collapsed"/>
                <TabItem Header="{lex:Loc Controls}"
                         Visibility="Collapsed">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Top">
                            <Label Content="{lex:Loc DeadZoneType}"/>
                            <ComboBox MinWidth="160"
                                      SelectedIndex="{Binding RSDeadTypeIndex,FallbackValue='0'}"
                                      VerticalContentAlignment="Center"
                                      Margin="10,0,0,0">
                                <ComboBoxItem Content="{lex:Loc Radial}"/>
                                <ComboBoxItem Content="{lex:Loc Axial}"/>
                            </ComboBox>
                        </StackPanel>

                        <TabControl DockPanel.Dock="Top"
                                    SelectedIndex="{Binding RSDeadTypeIndex,Mode=OneWay,FallbackValue='0'}"
                                    BorderBrush="{x:Null}"
                                    Padding="0"
                                    Margin="0,8,0,8">
                            <TabItem Header="{lex:Loc Radial}"
                                     Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    </Grid.RowDefinitions>

                                    <Label Content="{lex:Loc DeadZone}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="0"
                                           Grid.Column="0"/>
