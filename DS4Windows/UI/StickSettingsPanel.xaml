<UserControl xmlns:lex="http://wpflocalizeextension.codeplex.com" x:Class="DS4Windows.UI.StickSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4Windows.UI"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="800"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings">
    <StackPanel>
        <GroupBox Header="{lex:Loc StickSettingsPanel_LS}">
            <local:StickSideSettingsView x:Name="leftView"
                                         DataContext="{Binding Left}"/>
        </GroupBox>
        <GroupBox Header="{lex:Loc StickSettingsPanel_RS}">
            <local:StickSideSettingsView x:Name="rightView"
                                         DataContext="{Binding Right}"/>
        </GroupBox>
    </StackPanel>
</UserControl>
