<UserControl x:Class="DS4Windows.UI.StickSideSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4Windows.UI"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings">
    <UserControl.Resources>
        <Thickness x:Key="spaceMargin"
                   Left="10"
                   Bottom="6"/>
        <Style x:Key="gridRowHeight"
               TargetType="{x:Type RowDefinition}">
            <Setter Property="Height"
                    Value="30"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{lex:Loc OutputMode}"/>
            <ComboBox MinWidth="160"
                      SelectedIndex="{Binding OutputIndex,FallbackValue='0'}"
                      VerticalContentAlignment="Center"
                      Margin="10,0,0,0">
                <ComboBoxItem Content="{lex:Loc None}"/>
                <ComboBoxItem Content="{lex:Loc Controls}"/>
                <ComboBoxItem Content="{lex:Loc FlickStick}"/>
            </ComboBox>
        </StackPanel>

        <TabControl SelectedIndex="{Binding OutputIndex,Mode=OneWay,FallbackValue='0'}"
                    BorderBrush="{x:Null}"
                    Padding="0"
                    Margin="0,10,0,0">
            <TabItem Header="{lex:Loc None}"
                     Visibility="Collapsed"/>
            <TabItem Header="{lex:Loc Controls}"
                     Visibility="Collapsed">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top">
                        <Label Content="{lex:Loc DeadZoneType}"/>
                        <ComboBox MinWidth="160"
                                  SelectedIndex="{Binding DeadTypeIndex,FallbackValue='0'}"
                                  VerticalContentAlignment="Center"
                                  Margin="10,0,0,0">
                            <ComboBoxItem Content="{lex:Loc Radial}"/>
                            <ComboBoxItem Content="{lex:Loc Axial}"/>
                        </ComboBox>
                    </StackPanel>

                    <TabControl DockPanel.Dock="Top"
                                SelectedIndex="{Binding DeadTypeIndex,Mode=OneWay,FallbackValue='0'}"
                                BorderBrush="{x:Null}"
                                Padding="0"
                                Margin="0,8,0,8">
                        <TabItem Header="{lex:Loc Radial}"
                                 Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                    <RowDefinition Style="{StaticResource gridRowHeight}"/>
                                </Grid.RowDefinitions>

                                <Label Content="{lex:Loc DeadZone}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="0"
                                       Grid.Column="0"/>
                                <!-- 2026-09-26: UpdateSourceTrigger=LostFocus を撤廃（Six Axis の Dead Zone と同じく即時に設定へ書き込み、Controller Readings の円を即時に更新する。Phase6-Step7b-Plan.md の範囲外の追加修正） -->
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   Value="{Binding DeadZone}"
                                                   FormatString="F2"
                                                   Style="{StaticResource NumberInputSmall}"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Maximum="1.0"
                                                   Minimum="0.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"/>

                                <Label Content="{lex:Loc MaxZone}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="1"
                                       Grid.Column="0"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   Value="{Binding MaxZone}"
                                                   FormatString="F2"
                                                   Style="{StaticResource NumberInputSmall}"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Maximum="1.0"
                                                   Minimum="0.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"/>

                                <Label Content="{lex:Loc AntiDeadZone}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="2"
                                       Grid.Column="0"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   Value="{Binding AntiDeadZone}"
                                                   FormatString="F2"
                                                   Style="{StaticResource NumberInputSmall}"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Maximum="1.0"
                                                   Minimum="0.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}">
                                    <xctk:DoubleUpDown.ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{lex:Loc AntiDeadzoneTooltip}">
                                        </TextBlock>
                                    </xctk:DoubleUpDown.ToolTip>
                                </xctk:DoubleUpDown>

                                <Label Content="{lex:Loc MaxOutput}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="3"
                                       Grid.Column="0"/>
                                <DockPanel Grid.Row="3"
                                           Grid.Column="1">
                                    <CheckBox Content="{lex:Loc StickSideSettingsView_Force}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding MaxOutputForce}"
                                              ToolTip="{lex:Loc StickMaxOutputForceTooltip}"
                                              DockPanel.Dock="Right"
                                              Margin="8,0,0,0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       Value="{Binding MaxOutput}"
                                                       FormatString="F2"
                                                       Style="{StaticResource NumberInputSmall}"
                                                       Maximum="1.0"
                                                       Minimum="0.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"
                                                       DockPanel.Dock="Left">
                                        <xctk:DoubleUpDown.ToolTip>
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="{lex:Loc StickMaxOutputTooltip}">
                                            </TextBlock>
                                        </xctk:DoubleUpDown.ToolTip>
                                    </xctk:DoubleUpDown>
                                </DockPanel>

                                <Label Content="{lex:Loc VerticalScale}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="4"
                                       Grid.Column="0"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   Value="{Binding VerticalScale}"
                                                   FormatString="F2"
                                                   Style="{StaticResource NumberInputSmall}"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Maximum="4.0"
                                                   Minimum="0.0"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"/>

                                <Label Content="{lex:Loc Sensitivity}"
                                       ContentStringFormat="{}{0}:"
                                       Grid.Row="5"
                                       Grid.Column="0"/>
                                <xctk:DoubleUpDown d:IsHidden="True"
                                                   FormatString="F2"
                                                   Value="{Binding Sens}"
                                                   Style="{StaticResource NumberInputSmall}"
                                                   Grid.Row="5"
                                                   Grid.Column="1"
                                                   Maximum="5.0"
                                                   Minimum="0.1"
                                                   Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}"/>

                            </Grid>
                        </TabItem>

                        <TabItem Header="{lex:Loc Axial}"
                                 Visibility="Collapsed">
                            <local:AxialStickUserControl x:Name="axialStickControl"/>
                        </TabItem>
                    </TabControl>

                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition Style="{StaticResource gridRowHeight}"/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Content="{lex:Loc OutputCurve}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="0"
                               Grid.Column="0"/>
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  SelectedIndex="{Binding OutputCurveIndex}"
                                  Margin="{StaticResource spaceMargin}">
                            <ComboBoxItem Content="{lex:Loc Linear}"/>
                            <ComboBoxItem Content="{lex:Loc EnhancedPrecision}"/>
                            <ComboBoxItem Content="{lex:Loc Quadratic}"/>
                            <ComboBoxItem Content="{lex:Loc Cubic}"/>
                            <ComboBoxItem Content="{lex:Loc EaseoutQuad}"/>
                            <ComboBoxItem Content="{lex:Loc EaseoutCubic}"/>
                            <ComboBoxItem Content="{lex:Loc Custom}"/>
                        </ComboBox>

                        <DockPanel Grid.Row="1"
                                   Grid.Column="1"
                                   IsEnabled="{Binding CustomCurveSelected}">
                            <Button x:Name="customEditorBtn"
                                    Content="..."
                                    Width="20"
                                    DockPanel.Dock="Right"
                                    Command="{Binding CustomEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="{StaticResource spaceMargin}"/>
                            <TextBox Text="{Binding CustomCurve,UpdateSourceTrigger=LostFocus,FallbackValue='0.00, 0.00, 1.00, 1.00'}"
                                     DockPanel.Dock="Left"
                                     Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>

                        <Label Content="{lex:Loc SquareStick}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="2"
                               Grid.Column="0"/>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right">
                            <CheckBox IsChecked="{Binding SquareStick}"
                                      Margin="{StaticResource spaceMargin}"
                                      VerticalAlignment="Center"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               FormatString="F1"
                                               Value="{Binding SquareRoundness,FallbackValue=5}"
                                               Style="{StaticResource NumberInputWide}"
                                               Minimum="0.0"
                                               Maximum="1000.0"
                                               Increment="1.0"
                                               IsEnabled="{Binding SquareStick}"
                                               Margin="{StaticResource spaceMargin}"/>
                        </StackPanel>

                        <Label Content="{lex:Loc Rotation}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="3"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="3"
                                   Grid.Column="1">
                            <TextBlock Text="{lex:Loc Unit_Degree}"
                                       DockPanel.Dock="Right"
                                       FontSize="18"
                                       Margin="{StaticResource spaceMargin}"/>
                            <xctk:IntegerUpDown d:IsHidden="True"
                                                Value="{Binding Rotation}"
                                                Minimum="-180"
                                                Maximum="180"
                                                Margin="{StaticResource spaceMargin}">
                                <xctk:IntegerUpDown.ToolTip>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{lex:Loc StickRotationTooltip}">
                                    </TextBlock>
                                </xctk:IntegerUpDown.ToolTip>
                            </xctk:IntegerUpDown>
                        </DockPanel>

                        <Label Content="{lex:Loc Fuzz}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="4"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="4"
                                   Grid.Column="1">
                            <TextBlock Text="{lex:Loc StickSideSettingsView_Units}"
                                       DockPanel.Dock="Right"
                                       FontSize="10"
                                       Margin="{StaticResource spaceMargin}"
                                       VerticalAlignment="Center"/>
                            <xctk:IntegerUpDown d:IsHidden="True"
                                                Value="{Binding Fuzz}"
                                                Minimum="0"
                                                Maximum="100"
                                                Margin="{StaticResource spaceMargin}">
                                <xctk:IntegerUpDown.ToolTip>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{lex:Loc StickFuzzTooltip}">
                                    </TextBlock>
                                </xctk:IntegerUpDown.ToolTip>
                            </xctk:IntegerUpDown>
                        </DockPanel>

                        <Label Content="{lex:Loc AntiSnapback}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="5"
                               Grid.Column="0"/>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right">
                            <CheckBox IsChecked="{Binding AntiSnapback}"
                                      Margin="{StaticResource spaceMargin}"
                                      VerticalAlignment="Center"/>
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               FormatString="F1"
                                               Value="{Binding AntiSnapbackDelta, FallbackValue=135}"
                                               Style="{StaticResource NumberInputWide}"
                                               Minimum="0.0"
                                               Maximum="256.0"
                                               Increment="1.0"
                                               IsEnabled="{Binding AntiSnapback}"
                                               Margin="{StaticResource spaceMargin}"/>
                            <TextBlock Text="{lex:Loc StickSideSettingsView_Units}"
                                       DockPanel.Dock="Right"
                                       FontSize="10"
                                       Margin="{StaticResource spaceMargin}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Label Content="{lex:Loc AntiSnapbackTiming}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="6"
                               Grid.Column="0"/>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right">
                            <xctk:IntegerUpDown d:IsHidden="True"
                                                FormatString="F1"
                                                Value="{Binding AntiSnapbackTimeout}"
                                                Style="{StaticResource NumberInputWide}"
                                                Minimum="0"
                                                Maximum="1000"
                                                Increment="1"
                                                IsEnabled="{Binding AntiSnapback}"
                                                Margin="{StaticResource spaceMargin}"/>
                            <TextBlock Text="{lex:Loc Ui_Ms}"
                                       DockPanel.Dock="Right"
                                       FontSize="10"
                                       Margin="{StaticResource spaceMargin}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Label Content="{lex:Loc OuterBtn}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="7"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="7"
                                   Grid.Column="1">
                            <Label x:Name="outerBindLb"
                                   Content="{Binding MappingName,FallbackValue=Unassigned}"
                                   Margin="{StaticResource spaceMargin}"
                                   HorizontalAlignment="Center"
                                   DockPanel.Dock="Top"/>
                        </DockPanel>

                        <Label Content="{lex:Loc OuterBtnDead}"
                               ContentStringFormat="{}{0}:"
                               Grid.Row="8"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="8"
                                   Grid.Column="1">
                            <xctk:DoubleUpDown d:IsHidden="True"
                                               FormatString="F2"
                                               Value="{Binding OuterBindDead}"
                                               Style="{StaticResource NumberInputWide}"
                                               Minimum="0.0"
                                               Maximum="1.0"
                                               Increment="0.1"
                                               Margin="{StaticResource spaceMargin}"
                                               ToolTip="{lex:Loc StickOuterBindDeadTooltip}"
                                               DockPanel.Dock="Top"/>
                            <CheckBox Content="{lex:Loc Ui_Invert}"
                                      IsChecked="{Binding OuterBindInvert}"
                                      ToolTip="{lex:Loc StickOuterBindInvertTooltip}"
                                      DockPanel.Dock="Top"
                                      HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Label Grid.Row="9"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Content="{lex:Loc StickCalibration}"
                               HorizontalContentAlignment="Center"
                               Margin="0 4 0 4"/>

                        <Label Content="{lex:Loc XAxisOffset}"
                               Grid.Row="10"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="10"
                                   Grid.Column="1">
                            <xctk:SByteUpDown d:IsHidden="True"
                                              Value="{Binding DriftXAxis,UpdateSourceTrigger=LostFocus}"
                                              Style="{StaticResource NumberInputSmall}"
                                              Maximum="127"
                                              Minimum="-127"
                                              Increment="1"
                                              Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>

                        <Label Content="{lex:Loc YAxisOffset}"
                               Grid.Row="11"
                               Grid.Column="0"/>
                        <DockPanel Grid.Row="11"
                                   Grid.Column="1">
                            <xctk:SByteUpDown d:IsHidden="True"
                                              Value="{Binding DriftYAxis,UpdateSourceTrigger=LostFocus}"
                                              Style="{StaticResource NumberInputSmall}"
                                              Maximum="127"
                                              Minimum="-127"
                                              Increment="1"
                                              Margin="{StaticResource spaceMargin}"/>
                        </DockPanel>
                        <Button Grid.Row="12"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="{lex:Loc AutomaticallyRecalibrateStick}"
                                Command="{Binding CalibrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>

                    <GroupBox Header="{lex:Loc DeltaAcceleration}"
                              DockPanel.Dock="Top">
                        <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="False">
                                <Label Content="{lex:Loc Enabled}"
                                       ContentStringFormat="{}{0}:"
                                       DockPanel.Dock="Left"/>
                                <CheckBox IsChecked="{Binding DeltaAccelEnabled}"
                                          Margin="{StaticResource spaceMargin}"
                                          DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Expander IsExpanded="{Binding DeltaAccelEnabled,Mode=OneTime}"
                                      Header="{lex:Loc Settings}">
                                <Grid IsEnabled="{Binding DeltaAccelEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <Label Content="{lex:Loc Multiplier}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="0"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding DeltaMultiplier}"
                                                       Style="{StaticResource NumberInputWide}"
                                                       Minimum="0.0"
                                                       Maximum="10.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"
                                                       Grid.Row="0"
                                                       Grid.Column="1"/>

                                    <Label Content="{lex:Loc MaxTravel}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="1"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding DeltaMaxTravel}"
                                                       Style="{StaticResource NumberInputWide}"
                                                       Minimum="0.0"
                                                       Maximum="1.0"
                                                       Increment="0.05"
                                                       Margin="{StaticResource spaceMargin}"
                                                       Grid.Row="1"
                                                       Grid.Column="1"/>

                                    <Label Content="{lex:Loc MinTravel}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="2"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding DeltaMinTravel}"
                                                       Style="{StaticResource NumberInputWide}"
                                                       Minimum="0.0"
                                                       Maximum="1.0"
                                                       Increment="0.05"
                                                       Margin="{StaticResource spaceMargin}"
                                                       Grid.Row="2"
                                                       Grid.Column="1"/>

                                    <Label Content="{lex:Loc EasingDuration}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="3"
                                           Grid.Column="0"/>
                                    <DockPanel Grid.Row="3"
                                               Grid.Column="1">
                                        <TextBlock Text="{lex:Loc RumbleMaxSecs}"
                                                   DockPanel.Dock="Right"
                                                   FontSize="10"
                                                   Margin="{StaticResource spaceMargin}"
                                                   VerticalAlignment="Center"/>
                                        <xctk:DoubleUpDown d:IsHidden="True"
                                                           FormatString="F2"
                                                           Value="{Binding DeltaEasingDuration}"
                                                           Style="{StaticResource NumberInputWide}"
                                                           Minimum="0.0"
                                                           Maximum="600.0"
                                                           Increment="0.1"
                                                           Margin="{StaticResource spaceMargin}"/>
                                    </DockPanel>

                                    <Label Content="{lex:Loc MinFactor}"
                                           ContentStringFormat="{}{0}:"
                                           Grid.Row="4"
                                           Grid.Column="0"/>
                                    <xctk:DoubleUpDown d:IsHidden="True"
                                                       FormatString="F2"
                                                       Value="{Binding DeltaMinFactor}"
                                                       Style="{StaticResource NumberInputWide}"
                                                       Minimum="1.0"
                                                       Maximum="10.0"
                                                       Increment="0.1"
                                                       Margin="{StaticResource spaceMargin}"
                                                       Grid.Row="4"
                                                       Grid.Column="1"/>
                                </Grid>
                            </Expander>

                        </StackPanel>
                    </GroupBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="{lex:Loc FlickStick}"
                     Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                        <RowDefinition Style="{StaticResource gridRowHeight}"/>
                    </Grid.RowDefinitions>

                    <Label Content="{lex:Loc RealWorldCalibration}"
                           ContentStringFormat="{}{0}:"
                           Grid.Row="0"
                           Grid.Column="0"/>
                    <xctk:DoubleUpDown d:IsHidden="True"
                                       Value="{Binding FlickRWC,UpdateSourceTrigger=LostFocus}"
                                       FormatString="F2"
                                       Style="{StaticResource NumberInputSmall}"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Maximum="200.0"
                                       Minimum="1.0"
                                       Increment="1.0"
                                       Margin="{StaticResource spaceMargin}"/>

                    <Label Content="{lex:Loc FlickThreshold}"
                           ContentStringFormat="{}{0}:"
                           Grid.Row="1"
                           Grid.Column="0"/>
                    <xctk:DoubleUpDown d:IsHidden="True"
                                       Value="{Binding FlickThreshold,UpdateSourceTrigger=LostFocus}"
                                       FormatString="F2"
                                       Style="{StaticResource NumberInputSmall}"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Maximum="1.0"
                                       Minimum="0.0"
                                       Increment="0.1"
                                       Margin="{StaticResource spaceMargin}"/>

                    <Label Content="{lex:Loc FlickTime}"
                           ContentStringFormat="{}{0}:"
                           Grid.Row="2"
                           Grid.Column="0"/>
                    <DockPanel Grid.Row="2"
                               Grid.Column="1">
                        <TextBlock Text="{lex:Loc StickSideSettingsView_Sec}"
                                   DockPanel.Dock="Right"
                                   Margin="{StaticResource spaceMargin}"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding FlickTime,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Maximum="10.0"
                                           Minimum="0.01"
                                           Increment="0.1"
                                           Margin="{StaticResource spaceMargin}"/>
                    </DockPanel>

                    <Label Content="{lex:Loc MinAngleThreshold}"
                           ContentStringFormat="{}{0}:"
                           Grid.Row="3"
                           Grid.Column="0"/>
                    <DockPanel Grid.Row="3"
                               Grid.Column="1">
                        <TextBlock Text="{lex:Loc Unit_Degree}"
                                   DockPanel.Dock="Right"
                                   FontSize="18"
                                   Margin="{StaticResource spaceMargin}"/>
                        <xctk:DoubleUpDown d:IsHidden="True"
                                           Value="{Binding MinAngleThreshold,UpdateSourceTrigger=LostFocus}"
                                           FormatString="F2"
                                           Style="{StaticResource NumberInputSmall}"
                                           Maximum="180.0"
                                           Minimum="0.0"
                                           Increment="0.5"
                                           Margin="{StaticResource spaceMargin}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
