<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DS4Windows.UI.Themes"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes -->
    <SolidColorBrush x:Key="ForegroundBrush"
                     Color="{x:Static SystemColors.ActiveCaptionTextColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"
                     Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#FF0066CC"/>
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="PaneGapBrush"
                     Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="PaneDividerBrush"
                     Color="Gray"/>
    <SolidColorBrush x:Key="OutputSelectedBrush"
                     Color="LimeGreen"/>
    <SolidColorBrush x:Key="WarningBrush"
                     Color="Red"/>
    <SolidColorBrush x:Key="LinkBrush"
                     Color="#FF3881D8"/>
    <SolidColorBrush x:Key="LinkAccentBrush"
                     Color="#FF0066CC"/>
    <SolidColorBrush x:Key="ControllerCanvasBackground"
                     Color="DimGray"/>
    <!-- Select action画面: ライトモード時は透明にして白背景のままにする -->
    <SolidColorBrush x:Key="BindingCanvasBackground"
            Color="Transparent"/>

    <!-- Dark にだけあった色。Default のスタイルは WPF 既定の見た目に任せているため参照されないが、色のキーを両テーマで揃える -->
    <SolidColorBrush x:Key="ControlBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="LinkHoverBrush" Color="#FF0066CC"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="{x:Static SystemColors.ControlLightColor}"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="#DADADA"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#000000"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="LightGray"/>

    <!-- 画面が持つ、テーマに左右されない表示色（現状の値のまま。テーマ別に変えたいときはここで変える） -->
    <SolidColorBrush x:Key="Readings.DeadZoneFill" Color="#4FCF1F1F"/>
    <SolidColorBrush x:Key="Readings.AlertFill" Color="#FFCF1F1F"/>
    <SolidColorBrush x:Key="Readings.MapValue" Color="#FFABABAB"/>
    <SolidColorBrush x:Key="Readings.Calibration" Color="#FF1FCF1F"/>
    <SolidColorBrush x:Key="Notification.Background" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Notification.Border" Color="#007ACC"/>
    <SolidColorBrush x:Key="Notification.Title" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Notification.Text" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="KeyHighlight.Background" Color="Black"/>
    <SolidColorBrush x:Key="KeyHighlight.Foreground" Color="White"/>
    <!-- ドキュメント表示（DocumentStyleGithubLike）の色。Dark にも同名のキーがある -->
    <SolidColorBrush x:Key="Template.Document.Border" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="Template.Document.CodeBackground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Template.Document.Heading" Color="#FF000000"/>
    <SolidColorBrush x:Key="Template.Document.InlineCodeBackground" Color="#12181F25"/>
    <SolidColorBrush x:Key="Template.Document.QuoteBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Template.Document.TableBorder" Color="#DFE2E5"/>
    <SolidColorBrush x:Key="Template.Document.TableRow" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Template.Document.TableRowAlt" Color="#F6F8FA"/>

    <system:String x:Key="KeyImageImg">key-solid.png</system:String>
    <system:String x:Key="CancelImg">cancel.png</system:String>
    <system:String x:Key="CheckedImg">checked.png</system:String>
    <system:String x:Key="BtImg">BT.png</system:String>
    <system:String x:Key="UsbImg">USB.png</system:String>
    <system:String x:Key="KeyUpImg">keyup.png</system:String>
    <system:String x:Key="KeyDownImg">keydown.png</system:String>
    <system:String x:Key="ClockImg">clock.png</system:String>
    <system:String x:Key="DS4ConfigImg">DS4 Config.png</system:String>

    <system:String x:Key="CopyImg">copy.png</system:String>
    <system:String x:Key="DeleteImg">delete.png</system:String>
    <system:String x:Key="EditImg">edit.png</system:String>
    <system:String x:Key="ExportImg">export.png</system:String>
    <system:String x:Key="ImportImg">import.png</system:String>
    <system:String x:Key="NewProfileImg">newprofile.png</system:String>

    <system:String x:Key="GitHubImg">GitHub-Mark-64px.png</system:String>

    <Style TargetType="FlowDocument"
           x:Key="DocumentStyleGithubLike">
        <Setter Property="FontFamily"
                Value="Calibri"/>
        <Setter Property="TextAlignment"
                Value="Left"/>
        <Setter Property="PagePadding"
                Value="0"/>
        <Setter Property="FontSize"
                Value="14"/>

        <Style.Resources>
            <Style TargetType="Section">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="Blockquote">
                        <Setter Property="Padding"
                                Value="10, 5"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource Template.Document.Border}"/>
                        <Setter Property="BorderThickness"
                                Value="5,0,0,0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="avalonEdit:TextEditor"
                   xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
                <Setter Property="Background"
                        Value="{StaticResource Template.Document.CodeBackground}"/>
                <Setter Property="HorizontalScrollBarVisibility"
                        Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility"
                        Value="Auto"/>
                <Setter Property="Margin"
                        Value="2,0,2,0"/>
                <Setter Property="Padding"
                        Value="3"/>
            </Style>

            <Style TargetType="Paragraph">
                <Setter Property="Margin"
                        Value="0, 7, 0, 0"/>

                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="Heading1">
                        <Setter Property="Margin"
                                Value="0, 0, 15, 0"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource Template.Document.Heading}"/>
                        <Setter Property="FontSize"
                                Value="28"/>
                        <Setter Property="FontWeight"
                                Value="UltraBold"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="Heading2">
                        <Setter Property="Margin"
                                Value="0, 0, 15, 0"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource Template.Document.Heading}"/>
                        <Setter Property="FontSize"
                                Value="21"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="Heading3">
                        <Setter Property="Margin"
                                Value="0, 0, 10, 0"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource Template.Document.Heading}"/>
                        <Setter Property="FontSize"
                                Value="17.5"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="Heading4">
                        <Setter Property="Margin"
                                Value="0, 0, 5, 0"/>

                        <Setter Property="Foreground"
                                Value="{StaticResource Template.Document.Heading}"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="CodeBlock">
                        <Setter Property="FontFamily"
                                Value="Courier New"/>
                        <Setter Property="FontSize"
                                Value="11.9"/>
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.InlineCodeBackground}"/>
                        <Setter Property="Padding"
                                Value="20, 10"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="Note">
                        <Setter Property="Margin"
                                Value="5,0,5,0"/>
                        <Setter Property="Padding"
                                Value="10, 5"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource Template.Document.Border}"/>
                        <Setter Property="BorderThickness"
                                Value="3,3,3,3"/>
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.QuoteBackground}"/>
                    </Trigger>

                </Style.Triggers>
            </Style>

            <Style TargetType="Run">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="CodeSpan">
                        <Setter Property="FontFamily"
                                Value="Courier New"/>
                        <Setter Property="FontSize"
                                Value="11.9"/>
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.InlineCodeBackground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Span">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="CodeSpan">
                        <Setter Property="FontFamily"
                                Value="Courier New"/>
                        <Setter Property="FontSize"
                                Value="11.9"/>
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.InlineCodeBackground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Hyperlink">
                <Setter Property="TextDecorations"
                        Value="None"/>
            </Style>

            <Style TargetType="Image">
                <Setter Property="RenderOptions.BitmapScalingMode"
                        Value="NearestNeighbor"/>
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="imageright">
                        <Setter Property="Margin"
                                Value="20,0,0,0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
		    The Table's style don't seem to support border-collapse.
		    By making the ruled line width 0.5 and applying it to cell and table,
		    it looks like the ruled lines are not doubled.
		    -->
            <Style TargetType="Table">
                <Setter Property="CellSpacing"
                        Value="0"/>
                <Setter Property="BorderThickness"
                        Value="0.5"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource Template.Document.TableBorder}"/>
                <Style.Resources>
                    <Style TargetType="TableCell">
                        <Setter Property="BorderThickness"
                                Value="0.5"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource Template.Document.TableBorder}"/>
                        <Setter Property="Padding"
                                Value="13, 6"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="TableRowGroup">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="TableHeader">
                        <Setter Property="FontWeight"
                                Value="DemiBold"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.TableRow}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TableRow">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="EvenTableRow">
                        <Setter Property="Background"
                                Value="{StaticResource Template.Document.TableRowAlt}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="BlockUIContainer">
                <Style.Triggers>
                    <Trigger Property="Tag"
                             Value="RuleSingle">
                        <Setter Property="Margin"
                                Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="RuleDouble">
                        <Setter Property="Margin"
                                Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="RuleBold">
                        <Setter Property="Margin"
                                Value="0,3"/>
                    </Trigger>

                    <Trigger Property="Tag"
                             Value="RuleBoldWithSingle">
                        <Setter Property="Margin"
                                Value="0,3"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>


    <!-- based on https://github.com/whistyun/MdXaml/blob/787605545ace5b7cd7d02ff19e80b1c7a019b0d3/MdXaml/Markdown.Style.xaml#L338
    need to use it here because I had to modify it to accomodate for dark theme too -->
    <Style x:Key="WindowStyle"
           TargetType="{x:Type Window}">
        <Setter Property="InputMethod.IsInputMethodEnabled"
                Value="True"/>
        <Setter Property="InputMethod.PreferredImeState"
                Value="Off"/>
    </Style>

    <!-- 数値の表示と入力の大きさ（見切れ防止の寸法）。Dark／Default に同じ寸法で持つ（ThemeTokenRuleTests が一致を検査する） -->
    <!-- 読み取り値のラベル: 3 桁（-128〜255）が欠けない幅。Dark は Label の色を引き継ぐ -->
    <Style x:Key="ReadingValueLabel" TargetType="{x:Type Label}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Padding" Value="1,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style x:Key="ReadingValueLabelWide" TargetType="{x:Type Label}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Padding" Value="1,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style x:Key="ReadingValueLabelCentered" TargetType="{x:Type Label}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Padding" Value="1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 数値入力（xctk の UpDown 全種）の最小幅 -->
    <Style x:Key="NumberInputSmall" TargetType="{x:Type Control}"><Setter Property="MinWidth" Value="50"/></Style>
    <Style x:Key="NumberInputMedium" TargetType="{x:Type Control}"><Setter Property="MinWidth" Value="60"/></Style>
    <Style x:Key="NumberInputLarge" TargetType="{x:Type Control}"><Setter Property="MinWidth" Value="80"/></Style>
    <Style x:Key="NumberInputWide" TargetType="{x:Type Control}"><Setter Property="MinWidth" Value="100"/></Style>
</ResourceDictionary>