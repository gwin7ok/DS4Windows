<Project>
  <PropertyGroup>
    <!-- Suppress WPF XAML-related false positive errors and CsWin32 design-time diagnostics -->
    <!-- Moved diagnostic suppression to .editorconfig (editor-level) per repository policy. -->
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <!-- Versioning: set the project's canonical version here. -->
    <!-- Canonical project version -->
    <Version>4.2.1</Version>
    <FileVersion>4.2.1</FileVersion>
    <AssemblyVersion>4.2.1</AssemblyVersion>
  </PropertyGroup>
</Project>
